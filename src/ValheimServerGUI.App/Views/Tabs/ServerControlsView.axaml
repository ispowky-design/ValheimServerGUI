<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="using:ValheimServerGUI.Localization"
             xmlns:c="using:ValheimServerGUI.App.Controls"
             xmlns:conv="using:ValheimServerGUI.App.Converters"
             xmlns:vm="using:ValheimServerGUI.App.ViewModels"
             x:Class="ValheimServerGUI.App.Views.Tabs.ServerControlsView"
             x:DataType="vm:MainWindowViewModel">

    <ScrollViewer>
        <StackPanel Margin="8" Spacing="2">
            <!-- Identity: name, port and password in one card, like the sections below. -->
            <c:GroupBox Header="{x:Static loc:Strings.ServerControls_Identity_Header}">
                <StackPanel Spacing="2">
                    <!-- Name (wide) + Port (narrow) on one row. -->
                    <Grid ColumnDefinitions="*,12,Auto">
                        <c:TextFormField Grid.Column="0" LabelText="{x:Static loc:Strings.ServerControls_Name_Label}"
                                         HelpText="{x:Static loc:Strings.ServerControls_Name_Help}"
                                         Value="{Binding Form.Name}" MaxLength="64" IsEnabled="{Binding AllowServerChanges}" />
                        <c:NumericFormField Grid.Column="2" Width="110" LabelText="{x:Static loc:Strings.ServerControls_Port_Label}"
                                            HelpText="{x:Static loc:Strings.ServerControls_Port_Help}"
                                            Value="{Binding Form.Port}" Minimum="1" Maximum="65535"
                                            IsEnabled="{Binding AllowServerChanges}" />
                    </Grid>

                    <c:TextFormField LabelText="{x:Static loc:Strings.ServerControls_Password_Label}"
                                     HelpText="{x:Static loc:Strings.ServerControls_Password_Help}"
                                     Value="{Binding Form.Password}" ShowValue="{Binding Form.ShowPassword}"
                                     IsInputEnabled="{Binding AllowServerChanges}">
                        <c:TextFormField.Affix>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Stretch">
                                <!-- Eye toggle (left of copy): open eye when shown, struck-through when hidden. -->
                                <Button Classes="affix" Command="{Binding Form.ToggleShowPasswordCommand}"
                                        ToolTip.Tip="{x:Static loc:Strings.ServerControls_ShowPassword_Tip}">
                                    <Image Width="16" Height="16"
                                           Source="{Binding Form.ShowPassword, Converter={x:Static conv:ShowPasswordToIconConverter.Instance}}" />
                                </Button>
                                <c:CopyButton Classes="affix" Text="{Binding Form.Password}"
                                              ToolTip.Tip="{x:Static loc:Strings.ServerControls_CopyPassword_Tip}" />
                            </StackPanel>
                        </c:TextFormField.Affix>
                    </c:TextFormField>
                </StackPanel>
            </c:GroupBox>

            <!-- World | Join Options -->
            <Grid ColumnDefinitions="*,12,*" Margin="0,4,0,0">
                <c:GroupBox Grid.Column="0" Header="{x:Static loc:Strings.ServerControls_World_Header}">
                    <StackPanel Spacing="4">
                        <Grid ColumnDefinitions="Auto,Auto,*,Auto,Auto,Auto,Auto">
                            <c:RadioFormField Grid.Column="0" GroupName="World" LabelText="{x:Static loc:Strings.ServerControls_ExistingWorld_Label}"
                                              Value="{Binding Form.UseNewWorld, Converter={x:Static conv:InverseBooleanConverter.Instance}}"
                                              IsEnabled="{Binding AllowServerChanges}" />
                            <c:RadioFormField Grid.Column="1" GroupName="World" LabelText="{x:Static loc:Strings.ServerControls_NewWorld_Label}" Margin="10,0,0,0"
                                              Value="{Binding Form.UseNewWorld}" IsEnabled="{Binding AllowServerChanges}" />
                            <c:SettingsButton Grid.Column="3" ToolTip.Tip="{x:Static loc:Strings.ServerControls_WorldSettings_Tip}"
                                              Command="{Binding WorldPreferencesCommand}" />
                            <c:RefreshButton Grid.Column="4" ToolTip.Tip="{x:Static loc:Strings.ServerControls_RefreshWorlds_Tip}"
                                             Command="{Binding RefreshWorldsCommand}" />
                            <c:OpenButton Grid.Column="5" ToolTip.Tip="{x:Static loc:Strings.ServerControls_OpenSaveFolder_Tip}"
                                          Command="{Binding OpenSaveFolderCommand}" />
                            <c:IconButton Grid.Column="6" IconName="OpenWeb_16x" ToolTip.Tip="{x:Static loc:Strings.ServerControls_WorldMap_Tip}"
                                          Command="{Binding ViewWorldMapCommand}" />
                        </Grid>

                        <c:DropdownFormField LabelText="{x:Static loc:Strings.ServerControls_SelectWorld_Label}" PlaceholderText="{x:Static loc:Strings.ServerControls_SelectWorld_Placeholder}"
                                             IsVisible="{Binding Form.UseNewWorld, Converter={x:Static conv:InverseBooleanConverter.Instance}}"
                                             ItemsSource="{Binding Form.Worlds}" Value="{Binding Form.ExistingWorld}"
                                             IsEnabled="{Binding CanSelectExistingWorld}" />
                        <c:TextFormField LabelText="{x:Static loc:Strings.ServerControls_NewWorldName_Label}" Watermark="{x:Static loc:Strings.ServerControls_NewWorldName_Watermark}"
                                         IsVisible="{Binding Form.UseNewWorld}"
                                         Value="{Binding Form.NewWorldName}" MaxLength="20"
                                         IsEnabled="{Binding AllowServerChanges}" />
                    </StackPanel>
                </c:GroupBox>

                <c:GroupBox Grid.Column="2" Header="{x:Static loc:Strings.ServerControls_JoinOptions_Header}">
                    <StackPanel Spacing="6">
                        <c:CheckBoxFormField LabelText="{x:Static loc:Strings.ServerControls_Public_Label}"
                                             HelpText="{x:Static loc:Strings.ServerControls_Public_Help}"
                                             Value="{Binding Form.IsPublic}" IsEnabled="{Binding AllowServerChanges}" />
                        <c:CheckBoxFormField LabelText="{x:Static loc:Strings.ServerControls_Crossplay_Label}"
                                             HelpText="{x:Static loc:Strings.ServerControls_Crossplay_Help}"
                                             Value="{Binding Form.Crossplay}" IsEnabled="{Binding AllowServerChanges}" />
                    </StackPanel>
                </c:GroupBox>
            </Grid>

            <!-- Advanced: process options, scheduled restarts, and saving/backups (formerly their own tab). -->
            <TextBlock Text="{x:Static loc:Strings.MainWindow_Tab_AdvancedControls}" FontSize="14" FontWeight="SemiBold"
                       Margin="2,12,0,2" Foreground="{DynamicResource SystemControlForegroundBaseHighBrush}" />
            <Grid ColumnDefinitions="*,12,Auto">
                <StackPanel Grid.Column="0" Spacing="2">
                    <c:GroupBox Header="{x:Static loc:Strings.AdvancedControls_OtherSettings_Header}">
                        <StackPanel Spacing="4">
                            <c:CheckBoxFormField LabelText="{x:Static loc:Strings.AdvancedControls_AutoStart_Label}"
                                                 HelpText="{x:Static loc:Strings.AdvancedControls_AutoStart_Help}"
                                                 Value="{Binding Form.AutoStart}" IsEnabled="{Binding AllowServerChanges}" />
                            <c:CheckBoxFormField LabelText="{x:Static loc:Strings.AdvancedControls_WriteLogs_Label}"
                                                 HelpText="{x:Static loc:Strings.AdvancedControls_WriteLogs_Help}"
                                                 Value="{Binding Form.WriteServerLogsToFile}" IsEnabled="{Binding AllowServerChanges}" />
                            <c:TextFormField LabelText="{x:Static loc:Strings.AdvancedControls_AdditionalArgs_Label}"
                                             HelpText="{x:Static loc:Strings.AdvancedControls_AdditionalArgs_Help}"
                                             Value="{Binding Form.AdditionalArgs}" MaxLength="32767"
                                             IsEnabled="{Binding AllowServerChanges}" />
                            <c:TextFormField LabelText="{x:Static loc:Strings.AdvancedControls_EnvironmentVariables_Label}"
                                             HelpText="{x:Static loc:Strings.AdvancedControls_EnvironmentVariables_Help}"
                                             Value="{Binding Form.EnvironmentVariables}" MaxLength="32767"
                                             IsEnabled="{Binding AllowServerChanges}" />
                            <Button Content="{x:Static loc:Strings.AdvancedControls_SetDirectories}" HorizontalAlignment="Left" Margin="0,4,0,0"
                                    Command="{Binding SetProfileDirectoriesCommand}" />
                        </StackPanel>
                    </c:GroupBox>

                    <c:GroupBox Header="{x:Static loc:Strings.AdvancedControls_ScheduledRestart_Header}">
                        <StackPanel Spacing="4">
                            <c:TextFormField LabelText="{x:Static loc:Strings.AdvancedControls_RestartTimes_Label}"
                                             HelpText="{x:Static loc:Strings.AdvancedControls_RestartTimes_Help}"
                                             Watermark="{x:Static loc:Strings.AdvancedControls_RestartTimes_Watermark}"
                                             Value="{Binding Form.ScheduledRestartTimes}" MaxLength="200"
                                             IsEnabled="{Binding AllowServerChanges}" />
                            <c:CheckBoxFormField LabelText="{x:Static loc:Strings.AdvancedControls_RestartBackup_Label}"
                                                 HelpText="{x:Static loc:Strings.AdvancedControls_RestartBackup_Help}"
                                                 Value="{Binding Form.BackupOnScheduledRestart}" IsEnabled="{Binding AllowServerChanges}" />
                            <c:CheckBoxFormField LabelText="{x:Static loc:Strings.AdvancedControls_RestartOnCrash_Label}"
                                                 HelpText="{x:Static loc:Strings.AdvancedControls_RestartOnCrash_Help}"
                                                 Value="{Binding Form.RestartOnCrash}" IsEnabled="{Binding AllowServerChanges}" />
                        </StackPanel>
                    </c:GroupBox>
                </StackPanel>

                <c:GroupBox Grid.Column="2" Header="{x:Static loc:Strings.AdvancedControls_SavingBackups_Header}" VerticalAlignment="Top">
                    <StackPanel Spacing="2" Width="190">
                        <c:NumericFormField LabelText="{x:Static loc:Strings.AdvancedControls_Backups_Label}" Value="{Binding Form.BackupCount}"
                                            Minimum="1" Maximum="1000" IsEnabled="{Binding AllowServerChanges}"
                                            HelpText="{x:Static loc:Strings.AdvancedControls_Backups_Help}" />
                        <c:DurationFormField LabelText="{x:Static loc:Strings.AdvancedControls_SaveInterval_Label}" Value="{Binding Form.SaveInterval}"
                                             Minimum="60" Maximum="86400" IsEnabled="{Binding AllowServerChanges}"
                                             HelpText="{x:Static loc:Strings.AdvancedControls_SaveInterval_Help}" />
                        <c:DurationFormField LabelText="{x:Static loc:Strings.AdvancedControls_ShortBackup_Label}" Value="{Binding Form.BackupIntervalShort}"
                                             Minimum="300" Maximum="2592000" IsEnabled="{Binding AllowServerChanges}"
                                             HelpText="{x:Static loc:Strings.AdvancedControls_ShortBackup_Help}" />
                        <c:DurationFormField LabelText="{x:Static loc:Strings.AdvancedControls_LongBackup_Label}" Value="{Binding Form.BackupIntervalLong}"
                                             Minimum="300" Maximum="2592000" IsEnabled="{Binding AllowServerChanges}"
                                             HelpText="{x:Static loc:Strings.AdvancedControls_LongBackup_Help}" />
                    </StackPanel>
                </c:GroupBox>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
