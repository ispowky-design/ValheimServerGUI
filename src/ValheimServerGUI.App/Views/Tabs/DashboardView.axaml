<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="using:ValheimServerGUI.Localization"
             xmlns:c="using:ValheimServerGUI.App.Controls"
             xmlns:conv="using:ValheimServerGUI.App.Converters"
             xmlns:vm="using:ValheimServerGUI.App.ViewModels"
             x:Class="ValheimServerGUI.App.Views.Tabs.DashboardView"
             x:DataType="vm:MainWindowViewModel">

    <UserControl.Styles>
        <!-- Status bar + dot colour by server state (Status* tokens in Palette.axaml). -->
        <Style Selector="Border.statusBar">
            <Setter Property="CornerRadius" Value="3" />
            <Setter Property="Background" Value="{DynamicResource StatusStoppedBrush}" />
        </Style>
        <Style Selector="Border.statusBar.running">
            <Setter Property="Background" Value="{DynamicResource StatusRunningBrush}" />
        </Style>
        <Style Selector="Border.statusBar.busy">
            <Setter Property="Background" Value="{DynamicResource StatusBusyBrush}" />
        </Style>
    </UserControl.Styles>

    <ScrollViewer HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="12,8,12,12" Spacing="12">

            <!-- ===== Header: server identity and state, with the world shortcuts. Start/Restart/Stop live in the top bar. ===== -->
            <c:DashboardCard Classes="untitled" Padding="18,16" Background="{DynamicResource HeroBackground}">
                <Grid ColumnDefinitions="Auto,*,Auto">
                    <Panel Grid.Column="0" Width="12" Height="12" Margin="2,0,12,0" VerticalAlignment="Center">
                        <Ellipse Classes="statusHalo"
                                 Classes.running="{Binding Dashboard.IsRunning}" Classes.busy="{Binding Dashboard.IsBusy}" />
                        <Ellipse Classes="statusDot"
                                 Classes.running="{Binding Dashboard.IsRunning}" Classes.busy="{Binding Dashboard.IsBusy}" />
                    </Panel>
                    <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Form.Name}" FontSize="22" FontWeight="Bold" TextTrimming="CharacterEllipsis"
                                   Foreground="{DynamicResource SystemControlForegroundBaseHighBrush}" />
                        <TextBlock FontSize="12" TextTrimming="CharacterEllipsis"
                                   Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}">
                            <TextBlock.Text>
                                <MultiBinding StringFormat="{x:Static loc:Strings.Dashboard_Subtitle}">
                                    <Binding Path="SelectedWorldText" />
                                    <Binding Path="Form.Port" />
                                </MultiBinding>
                            </TextBlock.Text>
                        </TextBlock>
                    </StackPanel>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                        <c:IconTextButton Glyph="{StaticResource Glyph.Folder}" Text="{x:Static loc:Strings.Dashboard_Action_OpenWorldFolder}"
                                          Command="{Binding OpenSaveFolderCommand}" />
                        <c:IconTextButton Glyph="{StaticResource Glyph.Web}" Text="{x:Static loc:Strings.Dashboard_Action_ConnectionCheck}"
                                          Command="{Binding ConnectionCheckCommand}" />
                        <c:IconTextButton Glyph="{StaticResource Glyph.Download}" Text="{x:Static loc:Strings.MainWindow_Menu_InstallServer}"
                                          Command="{Binding InstallServerCommand}" />
                    </StackPanel>
                </Grid>
            </c:DashboardCard>

            <!-- ===== Key figures ===== -->
            <Grid ColumnDefinitions="*,10,*,10,*,10,*">
                <c:DashboardCard Grid.Column="0" Title="{x:Static loc:Strings.Dashboard_Status_Title}" Glyph="{StaticResource NavIcon.Details}"
                                 Value="{Binding StatusText}"
                                 Caption="{Binding Details.Uptime, StringFormat={x:Static loc:Strings.Dashboard_Uptime_Caption}}">
                    <!-- State colour bar, level with the trend lines of the neighbouring cards. -->
                    <Border Classes="statusBar" Height="6" VerticalAlignment="Bottom"
                            Classes.running="{Binding Dashboard.IsRunning}" Classes.busy="{Binding Dashboard.IsBusy}" />
                </c:DashboardCard>

                <c:DashboardCard Grid.Column="2" Title="{x:Static loc:Strings.Dashboard_Players_Title}" Glyph="{StaticResource NavIcon.Players}"
                                 Value="{Binding Dashboard.PlayersOnlineText}" Caption="{Binding Dashboard.PlayersCaption}" />

                <c:DashboardCard Grid.Column="4" Title="{x:Static loc:Strings.Dashboard_Cpu_Title}" Glyph="{StaticResource Glyph.Cpu}"
                                 Value="{Binding Dashboard.CpuText}" Caption="{Binding Dashboard.CpuCaption}">
                    <c:Sparkline Height="28" Maximum="100" Capacity="{x:Static vm:DashboardViewModel.HistoryLength}"
                                 Values="{Binding Dashboard.CpuHistory}" Stroke="{DynamicResource ChartCpuBrush}" />
                </c:DashboardCard>

                <c:DashboardCard Grid.Column="6" Title="{x:Static loc:Strings.Dashboard_Memory_Title}" Glyph="{StaticResource Glyph.Memory}"
                                 Value="{Binding Dashboard.MemoryText}" Caption="{Binding Dashboard.MemoryCaption}">
                    <c:Sparkline Height="28" Capacity="{x:Static vm:DashboardViewModel.HistoryLength}"
                                 Values="{Binding Dashboard.MemoryHistory}" Stroke="{DynamicResource ChartMemoryBrush}" />
                </c:DashboardCard>
            </Grid>

            <!-- ===== Players | Connection + backups ===== -->
            <Grid ColumnDefinitions="*,10,*">
                <c:DashboardCard Grid.Column="0" Title="{x:Static loc:Strings.Dashboard_OnlinePlayers_Title}" Glyph="{StaticResource NavIcon.Players}">
                    <c:DashboardCard.HeaderContent>
                        <c:HyperlinkLabel Text="{x:Static loc:Strings.Players_ManagePlayers}" FontSize="11"
                                          Command="{Binding Players.ManagePlayersCommand}" />
                    </c:DashboardCard.HeaderContent>
                    <Panel MinHeight="96">
                        <TextBlock Text="{x:Static loc:Strings.Dashboard_OnlinePlayers_Empty}" FontStyle="Italic"
                                   VerticalAlignment="Center" HorizontalAlignment="Center"
                                   Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                                   IsVisible="{Binding !Dashboard.HasOnlinePlayers}" />
                        <ItemsControl ItemsSource="{Binding Dashboard.OnlinePlayers}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:PlayerRowViewModel">
                                    <Grid ColumnDefinitions="Auto,*,Auto" Margin="0,3">
                                        <Image Grid.Column="0" Source="{Binding PlatformIcon}" Width="16" Height="16" Margin="0,0,8,0" />
                                        <TextBlock Grid.Column="1" Text="{Binding DisplayName}" VerticalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis" />
                                        <TextBlock Grid.Column="2" Text="{Binding SinceText}" VerticalAlignment="Center" FontSize="11"
                                                   Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Panel>
                </c:DashboardCard>

                <c:DashboardCard Grid.Column="2" Title="{x:Static loc:Strings.Dashboard_Connection_Title}" Glyph="{StaticResource Glyph.Web}">
                    <StackPanel Spacing="2">
                        <c:LabelField LabelWidth="160" LabelText="{x:Static loc:Strings.ServerDetails_ExternalIp_Label}" Value="{Binding Details.ExternalIp}"
                                      HelpText="{x:Static loc:Strings.ServerDetails_ExternalIp_Help}">
                            <c:LabelField.TrailingContent>
                                <c:CopyButton Text="{Binding Details.ExternalIp}" ToolTip.Tip="{x:Static loc:Strings.ServerDetails_ExternalIp_CopyTip}" />
                            </c:LabelField.TrailingContent>
                        </c:LabelField>
                        <c:LabelField LabelWidth="160" LabelText="{x:Static loc:Strings.ServerDetails_InternalIp_Label}" Value="{Binding Details.InternalIp}"
                                      HelpText="{x:Static loc:Strings.ServerDetails_InternalIp_Help}">
                            <c:LabelField.TrailingContent>
                                <c:CopyButton Text="{Binding Details.InternalIp}" ToolTip.Tip="{x:Static loc:Strings.ServerDetails_InternalIp_CopyTip}" />
                            </c:LabelField.TrailingContent>
                        </c:LabelField>
                        <c:LabelField LabelWidth="160" LabelText="{x:Static loc:Strings.ServerDetails_LocalIp_Label}" Value="{Binding Details.LocalIp}"
                                      HelpText="{x:Static loc:Strings.ServerDetails_LocalIp_Help}">
                            <c:LabelField.TrailingContent>
                                <c:CopyButton Text="{Binding Details.LocalIp}" ToolTip.Tip="{x:Static loc:Strings.ServerDetails_LocalIp_CopyTip}" />
                            </c:LabelField.TrailingContent>
                        </c:LabelField>
                        <c:LabelField LabelWidth="160" LabelText="{x:Static loc:Strings.ServerDetails_InviteCode_Label}" Value="{Binding Details.InviteCode}"
                                      HelpText="{x:Static loc:Strings.ServerDetails_InviteCode_Help}">
                            <c:LabelField.TrailingContent>
                                <c:CopyButton Text="{Binding Details.InviteCode}" ToolTip.Tip="{x:Static loc:Strings.ServerDetails_InviteCode_CopyTip}"
                                              Opacity="{Binding Details.InviteCodeCopyable, Converter={x:Static conv:BooleanToOpacityConverter.Instance}}"
                                              IsHitTestVisible="{Binding Details.InviteCodeCopyable}" />
                            </c:LabelField.TrailingContent>
                        </c:LabelField>
                        <c:LabelField LabelWidth="160" LabelText="{x:Static loc:Strings.ServerDetails_LastWorldSave_Label}" Value="{Binding Details.LastWorldSave}" />
                        <c:LabelField LabelWidth="160" LabelText="{x:Static loc:Strings.ServerDetails_NextRestart_Label}" Value="{Binding Details.NextRestart}" />
                        <c:LabelField LabelWidth="160" LabelText="{x:Static loc:Strings.ServerDetails_AvgWorldSave_Label}" Value="{Binding Details.AverageWorldSave}"
                                      HelpText="{x:Static loc:Strings.ServerDetails_AvgWorldSave_Help}">
                            <c:LabelField.TrailingContent>
                                <!-- Empty, invisible icon slot so this help glyph lines up with the ones above it. -->
                                <c:IconButton Opacity="0" IsHitTestVisible="False" Focusable="False" />
                            </c:LabelField.TrailingContent>
                        </c:LabelField>
                        <TextBlock FontStyle="Italic" TextWrapping="Wrap" FontSize="11" Margin="0,2,0,0"
                                   Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                                   Text="{x:Static loc:Strings.ServerDetails_TroubleConnecting}" />
                        <Separator Margin="0,4" />
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Grid.Column="0" Spacing="1">
                                <TextBlock Text="{x:Static loc:Strings.Dashboard_Backup_Title}" FontSize="11" FontWeight="SemiBold"
                                           Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" />
                                <TextBlock Text="{Binding Dashboard.LastBackupText}" FontWeight="SemiBold" />
                                <TextBlock Text="{Binding Dashboard.BackupsCaption}" FontSize="11" TextTrimming="CharacterEllipsis"
                                           Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" />
                            </StackPanel>
                            <c:IconTextButton Grid.Column="1" VerticalAlignment="Center" Glyph="{StaticResource Glyph.Save}"
                                              Text="{x:Static loc:Strings.Backups_BackUpNow}" ToolTip.Tip="{x:Static loc:Strings.Backups_BackUpNow_Tip}"
                                              Command="{Binding Backups.BackUpNowCommand}" />
                        </Grid>
                    </StackPanel>
                </c:DashboardCard>
            </Grid>

            <!-- ===== Live server output ===== -->
            <c:DashboardCard Title="{x:Static loc:Strings.Dashboard_Console_Title}" Glyph="{StaticResource NavIcon.Logs}">
                <c:DashboardCard.HeaderContent>
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <c:HelpLabel HelpText="{x:Static loc:Strings.Dashboard_Console_Help}" />
                        <c:HyperlinkLabel Text="{x:Static loc:Strings.Dashboard_Console_ViewAll}" FontSize="11"
                                          Command="{Binding Dashboard.NavigateCommand}" CommandParameter="{x:Static vm:DashboardTarget.Logs}" />
                    </StackPanel>
                </c:DashboardCard.HeaderContent>
                <c:LogViewer Height="180" ItemsSource="{Binding Logs.ServerLines}" />
            </c:DashboardCard>
        </StackPanel>
    </ScrollViewer>
</UserControl>
