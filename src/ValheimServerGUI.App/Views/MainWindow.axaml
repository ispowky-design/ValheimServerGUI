<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="using:ValheimServerGUI.Localization"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="using:ValheimServerGUI.App.ViewModels"
        xmlns:conv="using:ValheimServerGUI.App.Converters"
        xmlns:c="using:ValheimServerGUI.App.Controls"
        xmlns:tabs="using:ValheimServerGUI.App.Views.Tabs"
        mc:Ignorable="d"
        x:Class="ValheimServerGUI.App.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        x:Name="Root"
        Width="980" Height="700"
        MinWidth="720" MinHeight="520"
        Title="{Binding Title}">

    <DockPanel>
        <!-- ===== Top bar ===== -->
        <!-- The app frame's top band: the menu on the left; on the right the server state pill, a label-less profile
             picker and the Start/Restart/Stop buttons, turning the bar into a single-window multi-profile control
             panel. The controls bind the same VM commands as the Server Controls tab and the tray, so their
             enablement is derived from the selected server. -->
        <Border DockPanel.Dock="Top" BorderThickness="0,0,0,1" BorderBrush="{DynamicResource AppBorderBrush}"
                Background="{DynamicResource LayerDarkest}" MinHeight="46">
        <DockPanel>
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="8"
                    VerticalAlignment="Center" Margin="8,0,12,0">
            <Border Classes="pill" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" Spacing="7">
                    <Panel Width="8" Height="8" VerticalAlignment="Center">
                        <Ellipse Classes="statusHalo"
                                 Classes.running="{Binding Dashboard.IsRunning}" Classes.busy="{Binding Dashboard.IsBusy}" />
                        <Ellipse Classes="statusDot"
                                 Classes.running="{Binding Dashboard.IsRunning}" Classes.busy="{Binding Dashboard.IsBusy}" />
                    </Panel>
                    <TextBlock Text="{Binding StatusText}" VerticalAlignment="Center" FontWeight="SemiBold" />
                </StackPanel>
            </Border>
            <TextBlock Text="{x:Static loc:Strings.MainWindow_Profile_Label}" VerticalAlignment="Center" Margin="6,0,0,0"
                       Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" />
            <c:DropdownFormField x:Name="ProfileDropdown" Width="180" VerticalAlignment="Center"
                                 ItemsSource="{Binding Profiles}" />
            <!-- The one place the server is started and stopped (the tray menu aside). Force stop is offered only once
                 a stop has run past the Preferences delay; never automatic. -->
            <c:IconTextButton x:Name="StartButton" Classes="primary" Glyph="{StaticResource Glyph.Play}"
                              Text="{x:Static loc:Strings.Dashboard_Start}" ToolTip.Tip="{x:Static loc:Strings.ServerAction_Start}"
                              Command="{Binding StartCommand}" />
            <c:IconTextButton x:Name="RestartButton" Glyph="{StaticResource Glyph.Restart}"
                              Text="{x:Static loc:Strings.Dashboard_Restart}" ToolTip.Tip="{x:Static loc:Strings.ServerAction_Restart}"
                              Command="{Binding RestartCommand}" />
            <c:IconTextButton x:Name="StopButton" Glyph="{StaticResource Glyph.Stop}"
                              Text="{x:Static loc:Strings.Dashboard_Stop}" ToolTip.Tip="{x:Static loc:Strings.ServerAction_Stop}"
                              Command="{Binding StopCommand}" />
            <c:IconTextButton x:Name="ForceStopButton" Glyph="{StaticResource Glyph.ForceStop}"
                              Text="{x:Static loc:Strings.ServerAction_ForceStop}" ToolTip.Tip="{x:Static loc:Strings.ServerAction_ForceStop_Tip}"
                              Command="{Binding ForceStopCommand}" IsVisible="{Binding ForceStopAvailable}" />
        </StackPanel>
        <Menu VerticalAlignment="Center" Margin="6,0,0,0">
            <MenuItem Header="{x:Static loc:Strings.MainWindow_Menu_File}" AutomationProperties.AutomationId="Menu_File">
                <MenuItem Header="{x:Static loc:Strings.MainWindow_Menu_NewWindow}" Command="{Binding NewWindowCommand}">
                    <MenuItem.Icon><c:IconImage IconName="AddImmediateWindow_16x" /></MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="{x:Static loc:Strings.MainWindow_Menu_NewProfile}" Command="{Binding NewProfileCommand}">
                    <MenuItem.Icon><c:IconImage IconName="NewFile_16x" /></MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="{x:Static loc:Strings.MainWindow_Menu_SaveProfile}" Command="{Binding SaveProfileCommand}">
                    <MenuItem.Icon><c:IconImage IconName="Save_16x" /></MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="{x:Static loc:Strings.MainWindow_Menu_SaveProfileAs}" Command="{Binding SaveProfileAsCommand}">
                    <MenuItem.Icon><c:IconImage IconName="Save_16x" /></MenuItem.Icon>
                </MenuItem>
                <Separator />
                <MenuItem Header="{x:Static loc:Strings.MainWindow_Menu_LoadProfile}" ItemsSource="{Binding Profiles}"
                          IsEnabled="{Binding HasProfiles}" x:CompileBindings="False">
                    <MenuItem.Icon><c:IconImage IconName="OpenFile_16x" /></MenuItem.Icon>
                    <MenuItem.Styles>
                        <!-- Tree=Logical: on desktop the submenu is a separate PopupRoot, so a default (visual)
                             ancestor search never reaches the Window and the command binds to null (the items
                             then render disabled). The logical tree survives the popup, so it resolves there. -->
                        <Style Selector="MenuItem > MenuItem">
                            <Setter Property="Command"
                                    Value="{Binding DataContext.LoadProfileCommand, RelativeSource={RelativeSource AncestorType=Window, Tree=Logical}}" />
                            <Setter Property="CommandParameter" Value="{Binding}" />
                        </Style>
                    </MenuItem.Styles>
                </MenuItem>
                <MenuItem Header="{x:Static loc:Strings.MainWindow_Menu_RemoveProfile}" ItemsSource="{Binding Profiles}"
                          IsEnabled="{Binding CanRemoveProfile}" x:CompileBindings="False">
                    <MenuItem.Icon><c:IconImage IconName="Cancel_16x" /></MenuItem.Icon>
                    <MenuItem.Styles>
                        <!-- Tree=Logical: see Load Profile above (desktop submenu popup breaks the visual search). -->
                        <Style Selector="MenuItem > MenuItem">
                            <Setter Property="Command"
                                    Value="{Binding DataContext.RemoveProfileCommand, RelativeSource={RelativeSource AncestorType=Window, Tree=Logical}}" />
                            <Setter Property="CommandParameter" Value="{Binding}" />
                        </Style>
                    </MenuItem.Styles>
                </MenuItem>
                <Separator />
                <MenuItem Header="{x:Static loc:Strings.MainWindow_Menu_Preferences}" Command="{Binding PreferencesCommand}"
                          AutomationProperties.AutomationId="Menu_Preferences">
                    <MenuItem.Icon><c:IconImage IconName="Settings_16x" /></MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="{x:Static loc:Strings.MainWindow_Menu_SetDirectories}" Command="{Binding SetDirectoriesCommand}">
                    <MenuItem.Icon><c:IconImage IconName="FolderInformation_16x" /></MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="{x:Static loc:Strings.MainWindow_Menu_InstallServer}" Command="{Binding InstallServerCommand}">
                    <MenuItem.Icon><c:IconImage IconName="UnsyncedCommits_16x_Horiz" /></MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="{x:Static loc:Strings.MainWindow_Menu_ConnectionCheck}" Command="{Binding ConnectionCheckCommand}" />
                <MenuItem Header="{x:Static loc:Strings.MainWindow_Menu_OpenSettingsDirectory}" Command="{Binding OpenSettingsDirectoryCommand}">
                    <MenuItem.Icon><c:IconImage IconName="OpenFolder_16x" /></MenuItem.Icon>
                </MenuItem>
                <Separator />
                <MenuItem Header="{x:Static loc:Strings.MainWindow_Menu_Close}" Command="{Binding CloseCommand}"
                          AutomationProperties.AutomationId="Menu_Close" />
            </MenuItem>
            <MenuItem Header="{x:Static loc:Strings.MainWindow_Menu_Help}">
                <MenuItem Header="{x:Static loc:Strings.MainWindow_Menu_OnlineManual}" Command="{Binding OnlineManualCommand}">
                    <MenuItem.Icon><c:IconImage IconName="OpenWeb_16x" /></MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="{x:Static loc:Strings.MainWindow_Menu_PortForwarding}" Command="{Binding PortForwardingCommand}">
                    <MenuItem.Icon><c:IconImage IconName="OpenWeb_16x" /></MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="{x:Static loc:Strings.MainWindow_Menu_BugReport}" Command="{Binding BugReportCommand}">
                    <MenuItem.Icon><c:IconImage IconName="NewBug_16x" /></MenuItem.Icon>
                </MenuItem>
                <Separator />
                <MenuItem Header="{x:Static loc:Strings.MainWindow_Menu_CheckForUpdates}" Command="{Binding CheckForUpdatesCommand}">
                    <MenuItem.Icon><c:IconImage IconName="UnsyncedCommits_16x_Horiz" /></MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="{x:Static loc:Strings.MainWindow_Menu_Discord}" Command="{Binding DiscordCommand}">
                    <MenuItem.Icon><c:IconImage IconName="DiscordLogo" /></MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="{x:Static loc:Strings.MainWindow_Menu_About}" Command="{Binding AboutCommand}" />
            </MenuItem>
        </Menu>
        </DockPanel>
        </Border>

        <!-- ===== Status bar ===== -->
        <Border DockPanel.Dock="Bottom" BorderThickness="0,1,0,0" Background="{DynamicResource LayerDarkest}"
                BorderBrush="{DynamicResource AppBorderBrush}" Padding="12,5">
            <Grid ColumnDefinitions="*,Auto">
                <!-- The server state is the top bar's pill; the footer only carries the update readout. -->
                <!-- Icon + text always render at full contrast; only the text turns into a clickable link
                     when there is somewhere to go (UpdateIsLink). Don't wrap the readout in a Button: a
                     disabled Button dims the icon and text to near-invisibility. -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                    <Image Width="16" Height="16" VerticalAlignment="Center"
                           RenderOptions.BitmapInterpolationMode="HighQuality"
                           Source="{Binding UpdateStatus, Converter={x:Static conv:UpdateStatusToIconConverter.Instance}}" />
                    <TextBlock Text="{Binding UpdateStatusText}" VerticalAlignment="Center"
                               IsVisible="{Binding UpdateIsLink, Converter={x:Static conv:InverseBooleanConverter.Instance}}" />
                    <c:HyperlinkLabel Text="{Binding UpdateStatusText}" VerticalAlignment="Center"
                                      Command="{Binding UpdateLinkCommand}" IsVisible="{Binding UpdateIsLink}" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- ===== Tabs ===== -->
        <TabControl Theme="{StaticResource SidebarTabControl}" x:Name="Tabs" SelectionChanged="OnTabChanged">
            <TabItem Header="{x:Static loc:Strings.MainWindow_Tab_Dashboard}" Tag="{StaticResource NavIcon.Dashboard}" x:Name="DashboardTab">
                <tabs:DashboardView />
            </TabItem>
            <TabItem Header="{x:Static loc:Strings.MainWindow_Tab_ServerControls}" Tag="{StaticResource NavIcon.Server}" x:Name="ServerControlsTab">
                <tabs:ServerControlsView />
            </TabItem>
            <TabItem Header="{x:Static loc:Strings.MainWindow_Tab_Players}" Tag="{StaticResource NavIcon.Players}" x:Name="PlayersTab">
                <tabs:PlayersView />
            </TabItem>
            <TabItem Header="{x:Static loc:Strings.MainWindow_Tab_Backups}" Tag="{StaticResource NavIcon.Backups}" x:Name="BackupsTab">
                <tabs:BackupsView />
            </TabItem>
            <TabItem Header="{x:Static loc:Strings.MainWindow_Tab_WorldMap}" Tag="{StaticResource NavIcon.Map}" x:Name="WorldMapTab">
                <tabs:WorldMapView />
            </TabItem>
            <TabItem Header="{x:Static loc:Strings.MainWindow_Tab_Logs}" Tag="{StaticResource NavIcon.Logs}" x:Name="LogsTab">
                <tabs:LogsView />
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
