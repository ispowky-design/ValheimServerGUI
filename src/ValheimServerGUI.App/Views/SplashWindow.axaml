<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:ValheimServerGUI.App.ViewModels"
        xmlns:app="using:ValheimServerGUI.App"
        x:Class="ValheimServerGUI.App.Views.SplashWindow"
        x:DataType="vm:SplashViewModel"
        Width="420" Height="200"
        CanResize="False"
        WindowDecorations="None"
        WindowStartupLocation="CenterScreen"
        ShowInTaskbar="False"
        Title="{x:Static app:AppConstants.ProductName}">

    <Border Background="{DynamicResource HeroBackground}" BorderBrush="{DynamicResource CardBorderBrush}"
            BorderThickness="1" Padding="24">
        <Grid RowDefinitions="*,Auto,Auto">
            <!-- Brand: rune mark tile beside the product name and version. -->
            <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="14"
                        VerticalAlignment="Center" HorizontalAlignment="Center">
                <Border Width="52" Height="52" CornerRadius="13" Background="{DynamicResource SystemAccentColor}">
                    <PathIcon Width="30" Height="30" Data="{StaticResource NavIcon.Brand}"
                              Foreground="{DynamicResource AccentForeground}" />
                </Border>
                <StackPanel VerticalAlignment="Center" Spacing="2">
                    <TextBlock Text="{x:Static app:AppConstants.ProductName}" FontSize="22" FontWeight="Bold" />
                    <TextBlock Text="{Binding Version}"
                               Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" />
                </StackPanel>
            </StackPanel>

            <ProgressBar Grid.Row="1" Minimum="0" Maximum="100" CornerRadius="3"
                         Value="{Binding ProgressPercent}" Height="6" Margin="0,0,0,8" />
            <TextBlock Grid.Row="2" Text="{Binding StatusText}"
                       Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" />
        </Grid>
    </Border>
</Window>
