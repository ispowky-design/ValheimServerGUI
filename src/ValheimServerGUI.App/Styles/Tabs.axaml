<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Dialog tab strip (Manage Players): flat text tabs over a hairline, the selected one in full contrast with an
         accent underline, and the content on a rounded card below. Window-scoped by design (see the App.axaml
         note): each dialog with a TabControl merges this dictionary into its own resources rather than it being a
         global stock override. The main window has its own sidebar theme (Styles/Sidebar.axaml). Colours come
         from Palette.axaml. -->
    <ControlTheme x:Key="{x:Type TabItem}" TargetType="TabItem">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="Foreground" Value="{DynamicResource SystemControlForegroundBaseMediumBrush}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Padding" Value="12,7" />
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <ControlTemplate>
                <Panel Name="PART_LayoutRoot" Background="{TemplateBinding Background}">
                    <ContentPresenter Name="PART_ContentPresenter"
                                      Content="{TemplateBinding Header}"
                                      ContentTemplate="{TemplateBinding HeaderTemplate}"
                                      Padding="{TemplateBinding Padding}"
                                      HorizontalAlignment="Center" VerticalAlignment="Center" />
                    <!-- Accent underline below the selected tab. -->
                    <Border Name="PART_Accent" Height="2" VerticalAlignment="Bottom" CornerRadius="1" Margin="6,0"
                            Background="{DynamicResource SystemAccentColor}" IsVisible="False" />
                </Panel>
            </ControlTemplate>
        </Setter>

        <Style Selector="^:selected">
            <Setter Property="Foreground" Value="{DynamicResource SystemControlForegroundBaseHighBrush}" />
        </Style>
        <Style Selector="^:selected /template/ Border#PART_Accent">
            <Setter Property="IsVisible" Value="True" />
        </Style>
        <Style Selector="^:pointerover:not(:selected)">
            <Setter Property="Foreground" Value="{DynamicResource SystemControlForegroundBaseHighBrush}" />
        </Style>
    </ControlTheme>

    <ControlTheme x:Key="{x:Type TabControl}" TargetType="TabControl">
        <Setter Property="Background" Value="{DynamicResource CardBackground}" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Template">
            <ControlTemplate>
                <DockPanel>
                    <Border DockPanel.Dock="Top" BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="0,0,0,1"
                            Margin="0,0,0,8">
                        <ItemsPresenter Name="PART_ItemsPresenter" ItemsPanel="{TemplateBinding ItemsPanel}" />
                    </Border>
                    <ContentPresenter Name="PART_SelectedContentHost"
                                      Content="{TemplateBinding SelectedContent}"
                                      ContentTemplate="{TemplateBinding SelectedContentTemplate}"
                                      Margin="{TemplateBinding Padding}" />
                </DockPanel>
            </ControlTemplate>
        </Setter>
    </ControlTheme>

</ResourceDictionary>
